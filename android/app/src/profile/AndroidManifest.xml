<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext traffic (http:// dev backends) is enabled for all variants in the MAIN manifest:
         the native audio stack honours Android's network security policy in release builds too,
         so a profile-only flag made release builds upload fine but never play. -->
</manifest>
